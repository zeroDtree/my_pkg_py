{
    "terminal.integrated.profiles.linux": {
        "bash": {
            "path": "bash",
            "icon": "terminal-bash"
        },
        "zsh": {
            "path": "zsh"
        },
        "fish": {
            "path": "fish"
        },
        "tmux": {
            "path": "tmux",
            "icon": "terminal-tmux"
        },
        "pwsh": {
            "path": "pwsh",
            "icon": "terminal-powershell"
        }
    },
    "terminal.integrated.defaultProfile.linux": "fish",
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "files.exclude": {
        ".benchmarks": true,
        // --- Python 测试与代码检查缓存 ---
        "**/.pytest_cache": true,
        "**/.tox": true,
        "**/.nox": true,
        "**/.coverage": true,
        "**/htmlcov": true,
        "**/.hypothesis": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/.pytype": true,
        "**/.pyre": true,
        "**/.dmypy.json": true,
        "**/__pycache__": true,
        "**/.ipynb_checkpoints": true,
        "**/.nyc_output": true,
        // --- Python 虚拟环境 ---
        "**/.venv": true,
        // --- AI 编程工具与助手目录 ---
        "**/.cursor": true,
        "**/.cursorrules": true,
        "**/.claude": true,
        "**/.windsurf": true,
        "**/.aider*": true,
        "**/.copilot": true,
        "**/.cody": true,
        "**/.continue": true,
        "**/.tabnine": true,
        "**/.codeium": true,
        "**/.roo": true,
        "**/.trae": true,
        "**/.cline": true,
        "**/.comonad": true,
        "**/.gemini": true,
        "**/.opencode": true,
        "**/.amazonq": true,
        "**/.augment": true,
        "**/.factory": true,
        "**/.kiro": true,
        "**/.qoder": true,
    }
}